# Rails Database Configuration
DATABASE_DB=chat_development
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=app123456

REDIS_URL=redis://localhost:6379/0
REDIS_CABLE_URL=redis://localhost:6379/1

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

RABBITMQ_EXCHANGE_NAME=domain_events
RABBITMQ_QUEUE_NAME=chat_events_queue
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASSWORD=rabbit_app

# Kafka (Redpanda)
KAFKA_BROKERS=localhost:9092
KAFKA_ANALYTICS_TOPIC=analytics.message.events
KAFKA_ANALYTICS_CONSUMER_GROUP=analytics.projections
KAFKA_BRIDGE_QUEUE_NAME=analytics_kafka_bridge_queue
KAFKA_SNAPSHOT_INTERVAL=100

ANALYTICS_DB=chat_analytics
ANALYTICS_DATABASE_HOST=localhost
ANALYTICS_DATABASE_PORT=5436
ANALYTICS_DATABASE_URL=postgres://postgres:app123456@localhost:5436/chat_analytics
